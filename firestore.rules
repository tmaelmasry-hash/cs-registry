rules_version = '2';
// Example only. The app uses an API key with no Firebase Auth, so these rules
// can't identify a user. Choose ONE option and adapt it to your ethics/IRB requirements.
service cloud.firestore {
  match /databases/{database}/documents {

    // Option A: locked (default, safest). Cloud sync is disabled.
    match /{document=**} { allow read, write: if false; }

    // Option B: open only the registry collection. Anyone with the project ID + key
    // can read/write it, so store de-identified data only (no MRN / initials).
    // match /cs_patients/{id} { allow read, write: if true; }

    // Option C (recommended for multi-user teams): add Firebase Authentication
    // to the app, then require sign-in:
    // match /cs_patients/{id} { allow read, write: if request.auth != null; }
  }
}
